{
  "name": "crumbs",
  "version": "0.1.0",
  "description": "Autonomous Solana agent that earns the small, permissionless keeper rewards big bots ignore \u2014 profit proven by simulation before every action.",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --max-old-space-size=384 dist/src/index.js",
    "dev": "tsx --disable-warning=ExperimentalWarning src/index.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "record-fixtures": "tsx --disable-warning=ExperimentalWarning scripts/record-fixtures.ts",
    "approve": "tsx --disable-warning=ExperimentalWarning scripts/approve.ts",
    "survey": "tsx --disable-warning=ExperimentalWarning scripts/tuktuk-survey.ts",
    "simulate-task": "tsx --disable-warning=ExperimentalWarning scripts/simulate-task.ts",
    "new-wallet": "tsx scripts/new-wallet.ts",
    "export-key": "tsx scripts/export-key.ts",
    "validate-ix": "tsx --disable-warning=ExperimentalWarning scripts/validate-ix.ts",
    "discover": "tsx --disable-warning=ExperimentalWarning scripts/discover.ts",
    "telegram-setup": "tsx --disable-warning=ExperimentalWarning scripts/telegram-setup.ts",
    "report": "tsx --disable-warning=ExperimentalWarning scripts/report.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Midas3007/Crumbs.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Midas3007/Crumbs/issues"
  },
  "homepage": "https://github.com/Midas3007/Crumbs#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@solana/web3.js": "^1.99.0",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
