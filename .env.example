# ---- Crumbs configuration. Copy to .env and fill in. Never commit .env. ----

# shadow = simulate everything, send nothing (start here). live = actually send.
CRUMBS_MODE=shadow
# Hard kill switch. true = never send anything, and Telegram /resume can't override it.
CRUMBS_PAUSED=false

# --- Wallet ---
# Create one with:  npm run new-wallet   (saves keys/agent.json on this device)
AGENT_KEYPAIR_PATH=keys/agent.json
# Shadow mode only needs the public address (and ~0.01 SOL in it so simulations have a fee payer).
# AGENT_PUBKEY=

# --- RPC ---
# Free key at helius.dev. Without it the public RPC is used (slow, rate-limited).
HELIUS_API_KEY=
# RPC_URL=   (overrides the Helius URL if you use another provider)

# --- Telegram (alerts, /pause, one-tap approvals) ---
# Make a bot with @BotFather, then message it and get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discovery (AI reads programs to find new paid chores) ---
# Claude API key from console.anthropic.com. Without it discovery is off; everything else still runs.
# You get a Telegram alert if its credits run out (same for Helius).
ANTHROPIC_API_KEY=
# How often to scan for new jobs.
DISCOVERY_INTERVAL_HOURS=6
# Also scan programs deployed or upgraded recently (not just discovery/programs.json).
DISCOVERY_RECENT_DEPLOYS=true

# --- Public dashboard (see dashboard/README.md) ---
# Your Vercel dashboard URL and the same secret you set there as CRUMBS_PUSH_SECRET.
# Without these, the snapshot is still written to data/snapshot.json every minute.
DASHBOARD_URL=
DASHBOARD_SECRET=

# --- Safety caps (SOL) ---
# Most SOL the hot wallet may hold. Above this, Crumbs pauses until you move the extra out.
WALLET_CAP_SOL=0.5
# Most Crumbs may lose in one day (fees on races it lost). Hitting it pauses Crumbs.
DAILY_LOSS_CAP_SOL=0.02
# Most one job may spend on fees. Pricier jobs are skipped.
PER_JOB_SPEND_CAP_SOL=0.0002
# Smallest profit worth taking, in lamports (1 SOL = 1,000,000,000 lamports). 2000 ≈ $0.0004.
MIN_PROFIT_LAMPORTS=2000
# A job paying more than this many times its documented reward is treated as a possible bug: never executed.
ANOMALY_MULTIPLE=1.5

# --- Earnings to USDC ---
# Convert SOL earnings above the float to USDC (via Jupiter) so they don't swing with SOL's price.
SWEEP_TO_USDC=true
# SOL kept for fees.
SOL_FLOAT_SOL=0.05
# Don't swap less than this.
MIN_SWEEP_SOL=0.02
# Optional: send swept USDC to this (cold) wallet address. Leave empty to keep the USDC in the agent's own wallet.
COLD_WALLET=
# JUPITER_API_URL=https://lite-api.jup.ag/swap/v1

# --- Misc ---
DB_PATH=data/crumbs.db
POLL_INTERVAL_MS=1000
LOG_LEVEL=info
